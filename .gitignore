# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ============================================
# MONOREPO - Ignore node_modules everywhere
# ============================================
node_modules/
frontend/node_modules/
backend/node_modules/

# ============================================
# COMPILED OUTPUT
# ============================================
/dist
/tmp
/out-tsc
/bazel-out
frontend/dist/
frontend/.angular/
backend/dist/

# ============================================
# ENVIRONMENT FILES (IMPORTANT!)
# ============================================
backend/.env
.env.local
.env.*.local

# ============================================
# LOGS
# ============================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# ============================================
# IDEs and Editors
# ============================================
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# ============================================
# TESTING
# ============================================
/coverage
frontend/coverage/
backend/coverage/
/libpeerconnection.log
testem.log
/typings

# ============================================
# ANGULAR SPECIFIC
# ============================================
/.angular/cache
.sass-cache/
/connect.lock

# ============================================
# SYSTEM FILES
# ============================================
.DS_Store
Thumbs.db

# ============================================
# TEMPORARY FILES
# ============================================
*.tmp
*.temp
*.swp
*.swo
*~

# ============================================
# MONOREPO TEMP FOLDER
# ============================================
.monorepo-temp/

# ============================================
# PACKAGE MANAGER
# ============================================
package-lock.json
yarn.lock
pnpm-lock.yaml

# Keep frontend and backend package-lock.json for reproducible builds
!frontend/package-lock.json
!backend/package-lock.json
